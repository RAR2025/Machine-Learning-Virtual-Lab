# Copy to `.env` and adjust. Loaded by backend/core/config.py.
# Backend server
HOST=0.0.0.0
PORT=8000

# App metadata (shown in /docs and /api/health)
APP_TITLE=ML Virtual Lab - Decision Boundary Playground API
APP_VERSION=2.0.0

# Where the built React app lives (served by backend in production)
# FRONTEND_DIR=./frontend/dist

# Allowed frontend origin(s), comma-separated. FRONTEND_URL is auto-added.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
