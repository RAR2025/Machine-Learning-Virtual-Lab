# Copy to `.env` and adjust. All vars must start with VITE_ to reach the browser.
# Empty = relative "/api/..." (recommended): Vite proxy in dev, same-origin in prod.
VITE_API_URL=
# Dev-server proxy target (only used by `npm run dev` for /api/*).
BACKEND_URL=http://localhost:8000
# Dev-server port (optional).
FRONTEND_PORT=5173
